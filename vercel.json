{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "invite",
          "value": "(?<id>[A-Za-z0-9]+)"
        }
      ],
      "destination": "/i/:id",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/i/:id",
      "destination": "/api/invite?id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
